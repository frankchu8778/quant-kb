.env
# 原始 PDF 和 Windows 附加檔不進 git
inbox/**/*.pdf
*Zone.Identifier
# 大型產出物（圖片、模型、環境）
**/images/
*.lance/
__pycache__/
pipeline/logs/*.log
pipeline/_mineru_raw/
pipeline/_mineru_test/
# 數據（卡片、檢查結果、批次全文、manifest 與指紋）不進 git；POC 階段已提交的保留
cards/trial/
eval/trial/
cards/batch*/
eval/batch*/
fulltext/batch*/
fulltext/poc/clean-v2-standard/
catalog/
inbox/*/_selection.json
