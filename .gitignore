.env
# 原始 PDF 和 Windows 附加檔不進 git
inbox/**/*.pdf
*Zone.Identifier
# 大型產出物（圖片、模型、環境）
**/images/
*.lance/
__pycache__/
pipeline/logs/*.log
pipeline/logs/*.out
pipeline/logs/*.json
pipeline/_mineru_raw/
lab/pipeline/_mineru_test/
# 數據（卡片、檢查結果、批次全文、manifest 與指紋）不進 git；POC 階段已提交的保留
lab/cards/trial/
lab/eval/trial/
cards/batch*/
eval/batch*/
fulltext/batch*/
cards/sub*/
eval/sub*/
fulltext/sub*/
lab/fulltext/poc/clean-v2-standard/
catalog/
inbox/*/_selection.json
hold/
# 發布出去的知識庫（由 publish.py 產生）
/kb/
cards/poc/
eval/poc/
lab/eval/_notes_ab/
lab/eval/_stability/
lab/eval/_kimi_batch_probe/
# Agent Plan 路線的 Claude Code 設定資料夾（headless.py）
pipeline/agent_plan/.config/
pipeline/logs/*.jsonl
pipeline/experiments/_cache/
# 策略開發筆記（quant-kb skill 寫的，屬於研究資料）
/workspace/
