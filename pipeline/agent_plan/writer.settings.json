{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "API_TIMEOUT_MS": "1800000"
  },
  "permissions": {
    "deny": [
      "Bash",
      "BashOutput",
      "KillShell",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "TodoWrite",
      "Skill",
      "SlashCommand",
      "ExitPlanMode"
    ]
  },
  "disableAllHooks": true,
  "enableAllProjectMcpServers": false
}
