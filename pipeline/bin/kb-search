#!/usr/bin/env bash
# 知識庫查詢工具的捷徑：跑 pipeline/kbsearch.py（說明見該檔開頭）。
# Python：KB_SEARCH_PYTHON 環境變數 > ~/venvs/kb-parse/bin/python > PATH 上的 python3（要裝好 sentence-transformers 等依賴）
PY=${KB_SEARCH_PYTHON:-$HOME/venvs/kb-parse/bin/python}
[ -x "$PY" ] || PY=python3
exec "$PY" "$(dirname "$(readlink -f "$0")")/../kbsearch.py" "$@"
